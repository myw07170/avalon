# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# real-game.test.ts 落盘的对局记录 + transcript-page 生成的记录页，带真实发言，不入库
/transcripts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 样板文件不含任何密钥，必须入库
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
