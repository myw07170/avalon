# 复制为 .env.local 后填写。.env.local 已被 gitignore，本文件是唯一入库的样板。
#
# 这些变量只在服务端读取（src/app/api/ai/route.ts）。
# 绝对不要加 NEXT_PUBLIC_ 前缀——那会把 API key 打进浏览器包里。

# mock | deepseek | qwen | openai | anthropic
# 开发期保持 mock：一局 5 人约 60-80 次调用，用真实模型调 UI 会很快烧掉预算。
LLM_PROVIDER=mock

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# LLM 输出不合 zod schema 时的重试次数，用尽后由引擎在合法动作里随机兜底
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 以下全部属于【阶段 7：账号与运营】，现在不用配，不配也能正常跑。
#
# 只有要公开部署时才需要——那时 /api/ai 会变成任何人都能刷你 LLM 预算的接口。
# 详见 docs/architecture.md 与 docs/todos.md 阶段 7。
# ---------------------------------------------------------------------------

# 数据库 + 认证（Supabase 等）
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 支付（Stripe 等）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# 额度策略：新账号赠送的免费局数，以及单局 session 允许的最大 LLM 调用次数
# （上限是防刷的关键：只扣费不限调用，等于没扣费。10 人局峰值约 150 次）
# FREE_GAMES_PER_ACCOUNT=1
# MAX_AI_CALLS_PER_GAME=250
