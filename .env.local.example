# 复制为 .env.local 后填写。.env.local 已被 gitignore，本文件是唯一入库的样板。
#
# 这些变量只在服务端读取（src/app/api/ai/route.ts）。
# 绝对不要加 NEXT_PUBLIC_ 前缀——那会把 API key 打进浏览器包里。
#
# 【同名的真实环境变量优先于本文件】这是 Next 的行为（@next/env 只填 process.env 里
# 还没有的键），本项目照抄。所以如果你的系统里装过一个 LLM_API_KEY，它会静悄悄地
# 盖掉这里填的值，表现是一个毫无线索的 401。PowerShell 里查一下：
#   [Environment]::GetEnvironmentVariable('LLM_API_KEY','User')
# 有的话删掉再重开终端：
#   [Environment]::SetEnvironmentVariable('LLM_API_KEY', $null, 'User')

# mock | deepseek | qwen | openai
# 开发期保持 mock：一局 5 人约 60-80 次调用，用真实模型调 UI 会很快烧掉预算。
#
# 只支持 OpenAI 兼容协议（/chat/completions）。别的协议请走兼容网关，
# 把 LLM_BASE_URL 指过去即可——src/lib/ai/client.ts 刻意没有第二套请求分支。
LLM_PROVIDER=mock

LLM_API_KEY=

# 留空则按 provider 取默认值：
#   deepseek  https://api.deepseek.com/v1
#   qwen      https://dashscope.aliyuncs.com/compatible-mode/v1
#   openai    https://api.openai.com/v1
# 认不出的 provider 必须显式填这一项，否则开局就报 CONFIG_MISSING（不猜）。
LLM_BASE_URL=

LLM_MODEL=

# 采样温度。留空取默认 0.8（一桌 AI 说话才有点区别）；
# 写 default 表示**这个字段根本不发**，由模型自己定。
#
# OpenAI 的 gpt-5 系列（gpt-5 / gpt-5-mini / gpt-5-nano）必须写 default，
# 它只接受默认值，显式发 0.8 会被 400 顶回来：
#   Unsupported value: 'temperature' does not support 0.8 with this model
# 刻意不按模型名去猜要不要发——模型名和这个能力没有可靠对应关系，猜错的表现是开局一串 400。
LLM_TEMPERATURE=

# 单次调用超时，留空取 30000。
# 推理模型（gpt-5 系列、DeepSeek-R1）在吐 JSON 之前会先烧一大段 reasoning token，
# 30s 经常不够，建议 120000。超时按"可重试"处理，配小了的表现是白等好几个 30s 再报错。
# 注意走 /api/ai 时它受 route.ts 的 maxDuration=60 压制，调过 60s 没有意义。
LLM_TIMEOUT_MS=

# 单次调用的输出上限，留空则**整个字段不发**（用 provider 的默认）。
#
# 这是控制单次耗时最直接的一根杠杆：prompt 要求发言 2-5 句，实测模型普遍写 6-10 句，
# 超出的部分既没人读，也在实打实地拖时间。建议 700。
# 切太狠的症状是 JSON 被截断 -> schema 校验失败 -> 重试，**fallback 率会立刻反映**，
# 所以调这个值时盯着 real-game.test.ts 打出来的那个数字，不要盯感觉。
#
# 【人设生成不受这一项约束】/api/personas 一次要出齐全桌（10 份 × 每份 4 个 mind
# 字段），700 token 必然截断 -> 回退占位人设，而"一桌占位人设"恰恰是人设生成要修的
# 那个症状。所以 ai/personas.ts 在那一次调用上显式把它去掉了，是全项目唯一的例外。
LLM_MAX_TOKENS=

# 原样并进请求体的额外字段（一段 JSON 对象），覆盖同名项。
# 这是唯一一个 provider 专属参数的出口——与其为每家模型长一个分支，不如开一个通用口子。
#
# 【关思考模式的键每家都不一样，填错等于没填，而且不会有任何报错】
#   openai    gpt-5 系列：{"reasoning_effort":"minimal"}
#             默认每次调用要烧 1600+ reasoning token、12s，加上之后 1.5s（实测），
#             一局的时间和花费都差着一个量级
#   qwen      DashScope 兼容模式认的是 enable_thinking，**它不认 reasoning_effort**：
#             {"enable_thinking":false}
#             部分 qwen3 开源模型开着思考时要求 stream:true，撞上就改用 {"thinking_budget":0}
#   deepseek  deepseek-reasoner 关不掉思考，要快就换 deepseek-chat
#
# 不支持 json_object 的模型也可以从这里把 response_format 换掉。
# model 与 messages 不许覆盖，会直接报错。
LLM_EXTRA_BODY=

# src/lib/ai/real-game.test.ts 的开关：置 1 才会真跑一局（约 2 分钟 + 真金白银）。
# 和"配没配 key"分开是刻意的——否则 .env.local 一填好，往后每次 pnpm test 都烧一局。
# LLM_REAL_GAME=1

# ---------------------------------------------------------------------------
# 浏览器侧的开关。mock | remote，默认 mock。
#
# 上面那些变量浏览器一律读不到（走 /api/ai 与 /api/personas 转发），
# 所以另有这一个：它**只决定浏览器要不要走网络**，
# 不含任何密钥，会被打进浏览器包（NEXT_PUBLIC_ 前缀就是这个意思）。
# 选哪个模型仍然由上面的 LLM_PROVIDER 决定。
#
# 默认 mock 是刻意的：不会因为忘了配开关就悄悄开始花钱。要花钱得显式写 remote。
# 改动后需要重启 next dev —— NEXT_PUBLIC_ 是构建时内联的，不是运行时读的。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AI_MODE=mock

# LLM 输出不合 zod schema 时的重试次数，用尽后由引擎在合法动作里随机兜底。
# 这是服务端说了算的上限：请求里带的值只会被夹小，不会被放大
#（否则一个 maxRetries: 999 就能烧光预算）。
# 注意只有"模型说了胡话"才会兜底——没配 key、401、网络不通一律抛错，
# 静默兜底会让你以为在跑真模型，实际全局随机。
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 以下全部属于【阶段 7：账号与运营】，现在不用配，不配也能正常跑。
#
# 只有要公开部署时才需要——那时 /api/ai 会变成任何人都能刷你 LLM 预算的接口。
# 详见 docs/architecture.md 与 docs/todos.md 阶段 7。
# ---------------------------------------------------------------------------

# 数据库 + 认证（Supabase 等）
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 支付（Stripe 等）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# 额度策略：新账号赠送的免费局数，以及单局 session 允许的最大 LLM 调用次数
# （上限是防刷的关键：只扣费不限调用，等于没扣费。10 人局峰值约 150 次）
# FREE_GAMES_PER_ACCOUNT=1
# MAX_AI_CALLS_PER_GAME=250
